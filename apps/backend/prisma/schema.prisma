// Vanijya Prisma Schema
// SIH Problem Statement 26132: Strengthening Market Linkages & Price Discovery for Farmers

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  BUYER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CropLotStatus {
  OPEN
  BIDDING
  SOLD
  CANCELLED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum TransactionStatus {
  INITIATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  INITIATED
  PAID
  FAILED
}

enum PriceSource {
  AGMARKNET
  MOCK
}

enum QualityGrade {
  GRADE_A
  GRADE_B
  GRADE_C
}

enum CropUnit {
  QUINTAL
  KG
  TONNE
}

enum AuditAction {
  LOT_CREATED
  BID_PLACED
  QUANTITY_MODIFIED
  BID_CANCELLED
  BID_ACCEPTED
  BID_REJECTED
  PAYMENT_PAID
  PROFILE_UPDATED
  USER_REGISTERED
  USER_APPROVED
  USER_REJECTED
}

enum NotificationType {
  BID_RECEIVED
  BID_ACCEPTED
  BID_REJECTED
  BID_CANCELLED
  BID_MODIFIED
  LOT_CREATED
  LOT_SOLD
  PAYMENT_INITIATED
  PAYMENT_PAID
  PROFILE_INCOMPLETE
  SYSTEM
}

model User {
  id                 String             @id @default(uuid())
  name               String
  phone              String?            @unique
  email              String?            @unique
  passwordHash       String
  role               Role               @default(FARMER)
  verificationStatus VerificationStatus @default(PENDING)
  approvalStatus     ApprovalStatus     @default(PENDING)
  rejectionReason    String?
  approvedBy         String?
  approvedAt         DateTime?
  district           String?
  state              String?
  village            String?
  location           String?
  primaryCrop        String?
  farmSize           Float?
  preferredLanguage  String?            @default("en")
  contactPerson      String?
  businessType       String?
  warehouseLocation  String?
  organization       String?
  gstin              String?
  fssai              String?
  kccNumber          String?
  apmcLicense        String?
  isVerified         Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  cropLots           CropLot[]
  bids               Bid[]
  buyerTransactions  Transaction[]      @relation("BuyerTransactions")
  farmerTransactions Transaction[]      @relation("FarmerTransactions")
  auditLogs          AuditLog[]
  notifications      Notification[]

  @@index([role])
  @@index([approvalStatus])
  @@index([verificationStatus])
  @@index([district])
  @@index([state])
  @@map("users")
}

model Crop {
  id          String       @id @default(uuid())
  name        String       @unique
  category    String
  defaultUnit CropUnit     @default(QUINTAL)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  cropLots    CropLot[]
  mandiPrices MandiPrice[]

  @@map("crops")
}

model Market {
  id        String       @id @default(uuid())
  name      String
  district  String
  state     String
  latitude  Float?
  longitude Float?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  mandiPrices MandiPrice[]

  @@map("markets")
}

model MandiPrice {
  id              String      @id @default(uuid())
  cropId          String
  crop            Crop        @relation(fields: [cropId], references: [id], onDelete: Cascade)
  marketId        String
  market          Market      @relation(fields: [marketId], references: [id], onDelete: Cascade)
  minPrice        Float
  maxPrice        Float
  modalPrice      Float
  arrivalQuantity Float       @default(0)
  date            DateTime
  source          PriceSource @default(MOCK)
  createdAt       DateTime    @default(now())

  @@index([cropId, date])
  @@index([marketId, date])
  @@map("mandi_prices")
}

model CropLot {
  id            String        @id @default(uuid())
  farmerId      String
  farmer        User          @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropId        String
  crop          Crop          @relation(fields: [cropId], references: [id], onDelete: Cascade)
  quantity      Float
  unit          String        @default("QUINTAL")
  expectedPrice Float
  qualityGrade  QualityGrade  @default(GRADE_A)
  location      String
  harvestDate   DateTime?
  status        CropLotStatus @default(OPEN)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bids        Bid[]
  transaction Transaction?
  auditLogs   AuditLog[]

  @@index([farmerId])
  @@index([cropId])
  @@index([status])
  @@index([createdAt])
  @@map("crop_lots")
}

model Bid {
  id        String    @id @default(uuid())
  lotId     String
  lot       CropLot   @relation(fields: [lotId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  price     Float
  quantity  Float
  message   String?
  status    BidStatus @default(PENDING)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  transaction Transaction?
  auditLogs   AuditLog[]

  @@index([lotId])
  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
  @@map("bids")
}

model Transaction {
  id            String            @id @default(uuid())
  lotId         String            @unique
  lot           CropLot           @relation(fields: [lotId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User              @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
  farmerId      String
  farmer        User              @relation("FarmerTransactions", fields: [farmerId], references: [id], onDelete: Cascade)
  acceptedBidId String            @unique
  acceptedBid   Bid               @relation(fields: [acceptedBidId], references: [id], onDelete: Cascade)
  agreedPrice   Float
  quantity      Float
  totalAmount   Float
  status        TransactionStatus @default(INITIATED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  payment Payment?

  @@index([buyerId])
  @@index([farmerId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

model Payment {
  id               String        @id @default(uuid())
  transactionId    String        @unique
  transaction      Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount           Float
  status           PaymentStatus @default(PENDING)
  paymentReference String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@map("payments")
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  entityType  String?
  entityId    String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id          String      @id @default(uuid())
  bidId       String?
  bid         Bid?        @relation(fields: [bidId], references: [id], onDelete: SetNull)
  lotId       String?
  lot         CropLot?    @relation(fields: [lotId], references: [id], onDelete: SetNull)
  actorId     String
  actor       User        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action      AuditAction
  oldQuantity Float?
  newQuantity Float?
  oldStatus   String?
  newStatus   String?
  price       Float?
  metadata    String?
  createdAt   DateTime    @default(now())

  @@index([actorId])
  @@index([lotId])
  @@index([bidId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
