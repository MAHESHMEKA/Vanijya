# =================================================================
# Vanijya (वाणिज्य) Monorepo Environment Configuration Template
# =================================================================

# Backend Configuration (Port 4000)
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://vanijya_user:vanijya_pass@localhost:5432/vanijya_db?schema=public
JWT_SECRET=vanijya_super_secret_jwt_key_sih2024
JWT_EXPIRES_IN=7d

# Visual Alphanumeric CAPTCHA Configuration
# In production (NODE_ENV=production), CAPTCHA is strictly enforced.
# In local development / demo mode, CAPTCHA_ENABLED can be set to false for automated tests.
CAPTCHA_ENABLED=true
DEMO_MODE=true

# Market Data Provider (mock | government)
MARKET_DATA_PROVIDER=mock
GOV_MARKET_API_KEY=
GOV_MARKET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
PRICE_CACHE_TTL_MS=300000

# Frontend Configuration (Port 3000)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
